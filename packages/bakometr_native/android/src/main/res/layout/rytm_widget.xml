<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/rytm_widget_bg">
    <TextView
        android:id="@+id/w_score"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:gravity="center"
        android:background="@drawable/rytm_widget_ring"
        android:textColor="#FFD66B"
        android:textSize="24sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RYTM SNU"
            android:textColor="#8C93B8"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_sleep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8EAF6"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B59BFF"
            android:textSize="12sp"
            android:maxLines="2" />
        <TextView
            android:id="@+id/w_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8C93B8"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>

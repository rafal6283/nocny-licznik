<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <service
            android:name="pl.rafal.bakometr_native.TrackingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name="pl.rafal.bakometr_native.ReminderReceiver"
            android:exported="false" />

        <!-- Health Connect: ekran z wyjaśnieniem uprawnień (Android 9–13) … -->
        <activity
            android:name="pl.rafal.bakometr_native.HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- … i Android 14+ -->
        <activity-alias
            android:name="pl.rafal.bakometr_native.ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="pl.rafal.bakometr_native.HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
